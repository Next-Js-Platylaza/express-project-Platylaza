datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Book {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  author    String
  genre     String
  status    Status
  user      User @relation(fields: [userEmail], references: [email])
  userEmail String
}

model User {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  email     String  @unique
  password  String
  books     Book[]
}

enum Status {
  TO_READ
  READING
  FINISHED
}